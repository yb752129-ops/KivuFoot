# Copier ce fichier vers .env et renseigner de vraies valeurs.
# NE JAMAIS committer le fichier .env réel dans Git.

# --- Application ---
ENVIRONMENT=development
DEBUG=true
APP_NAME=KivuFoot API

# --- Base de données ---
# Format : postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://kivufoot:changeme@db:5432/kivufoot
DATABASE_URL_SYNC=postgresql+psycopg2://kivufoot:changeme@db:5432/kivufoot

# --- Sécurité / JWT ---
# Générer une vraie valeur avec : openssl rand -hex 32
SECRET_KEY=changez-moi-avec-une-vraie-cle-secrete-aleatoire
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Stockage fichiers (optionnel V1 - logos clubs) ---
S3_BUCKET=
S3_KEY=
S3_SECRET=
S3_ENDPOINT=

# --- Redis (DIFFÉRÉ en V1, voir rapport Phase 0/1 - laisser vide) ---
REDIS_URL=

# --- i18n ---
DEFAULT_LOCALE=fr
SUPPORTED_LOCALES=fr,sw

# --- Pagination / rate limiting ---
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100
RATE_LIMIT_LOGIN_PER_MINUTE=5

# --- PostgreSQL (utilisé par docker-compose pour créer la base) ---
POSTGRES_USER=kivufoot
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kivufoot
