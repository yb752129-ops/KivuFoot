generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPPORTER
  COLLECTOR
  CLUB_MANAGER
  ORGANIZER
  ADMIN
}

enum MatchStatus {
  DRAFT
  PENDING_VALIDATION
  OFFICIAL
  POSTPONED
  CANCELLED
}

enum EventType {
  GOAL
  OWN_GOAL
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION_IN
  SUBSTITUTION_OUT
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  password       String
  role           Role      @default(SUPPORTER)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  collectedMatches Match[] @relation("Collector")
  validatedMatches Match[] @relation("Validator")
}

model Club {
  id            String    @id @default(cuid())
  name          String
  logoUrl       String?
  city          String
  foundedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  players       Player[]
  homeMatches   Match[]   @relation("HomeTeam")
  awayMatches   Match[]   @relation("AwayTeam")
}

model Player {
  id            String       @id @default(cuid())
  firstName     String
  lastName      String
  dateOfBirth   DateTime?
  position      String?
  photoUrl      String?
  clubId        String
  club          Club         @relation(fields: [clubId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  events        MatchEvent[]
}

model Competition {
  id            String    @id @default(cuid())
  name          String
  city          String
  season        String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  matches       Match[]
}

model Match {
  id              String       @id @default(cuid())
  competitionId   String
  competition     Competition  @relation(fields: [competitionId], references: [id])
  homeClubId      String
  homeClub        Club         @relation("HomeTeam", fields: [homeClubId], references: [id])
  awayClubId      String
  awayClub        Club         @relation("AwayTeam", fields: [awayClubId], references: [id])
  date            DateTime
  venue           String?
  homeScore       Int?
  awayScore       Int?
  status          MatchStatus  @default(DRAFT)
  collectorId     String?
  collector       User?        @relation("Collector", fields: [collectorId], references: [id])
  validatedById   String?
  validator       User?        @relation("Validator", fields: [validatedById], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  events          MatchEvent[]
  auditLogs       AuditLog[]
}

model MatchEvent {
  id        String    @id @default(cuid())
  matchId   String
  match     Match     @relation(fields: [matchId], references: [id])
  playerId  String
  player    Player    @relation(fields: [playerId], references: [id])
  type      EventType
  minute    Int
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id])
  action    String
  details   String
  userId    String
  createdAt DateTime @default(now())
}
